# Salin file ini menjadi .env lalu isi nilainya
# Dapatkan semua key dari Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=ey...
