# Optional
CRON_SECRET=

# Smoke test v17 (gunakan akun uji, jangan akun pribadi)
APP_BASE_URL=http://localhost:3000
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
SMOKE_CS_EMAIL=
SMOKE_CS_PASSWORD=
